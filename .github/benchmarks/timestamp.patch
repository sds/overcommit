--- /dev/null
+++ b/spec/support/benchmark_mtimes.rb
@@ -0,0 +1,10 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  config.before(:each, :fixed_mtimes) do
+    timestamp = Time.at(1_000_000_000)
+    Dir['*'].select { |path| File.file?(path) }.each do |path|
+      File.utime(timestamp, timestamp, path)
+    end
+  end
+end
