diff --git a/lib/overcommit/utils.rb b/lib/overcommit/utils.rb
index 3acdfa21..00c6f8fc 100644
--- a/lib/overcommit/utils.rb
+++ b/lib/overcommit/utils.rb
@@ -166,6 +166,11 @@ module Overcommit
         return if Process.ppid.zero?
 
         if OS.windows?
+          begin
+            return native_windows_parent_command
+          rescue LoadError, StandardError
+            # Preserve the PowerShell fallback when OLE is unavailable.
+          end
           result = execute([
             'powershell.exe', '-NoProfile', '-NonInteractive', '-Command',
             "(Get-CimInstance Win32_Process -Filter 'ProcessId = #{Process.ppid}').CommandLine",
@@ -184,6 +189,14 @@ module Overcommit
         nil
       end
 
+      def native_windows_parent_command
+        require 'win32ole'
+        service = WIN32OLE.connect('winmgmts:root/cimv2')
+        processes = service.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE ProcessId = #{Process.ppid}")
+        processes.each { |process| return process.CommandLine }
+        nil
+      end
+
       # Execute a command in a subprocess, capturing exit status and output from
       # both standard and error streams.
       #
