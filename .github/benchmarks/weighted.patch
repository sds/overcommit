diff --git a/spec/support/spec_shard.rb b/spec/support/spec_shard.rb
index a77c6387..24f1a993 100644
--- a/spec/support/spec_shard.rb
+++ b/spec/support/spec_shard.rb
@@ -17,6 +17,25 @@ class SpecShard
     examples.each_with_index.select { |_, offset| offset % total == index - 1 }.map(&:first)
   end
 
+  def groups(examples, workers, weights = {})
+    if weights.empty?
+      selected = select(examples)
+      buckets = Array.new([workers, selected.size].min) { [] }
+      selected.each_with_index { |id, offset| buckets[offset % buckets.size] << id }
+      return buckets
+    end
+
+    count = [workers * total, examples.size].min
+    buckets = Array.new(count) { [] }
+    loads = Array.new(count, 0)
+    examples.sort_by { |id| [-weights.fetch(id, 1), id] }.each do |id|
+      target = (0...count).min_by { |offset| [loads[offset], offset] }
+      buckets[target] << id
+      loads[target] += weights.fetch(id, 1)
+    end
+    buckets.each_with_index.select { |_, offset| offset % total == index - 1 }.map(&:first)
+  end
+
   def to_s
     "#{index}/#{total}"
   end
